{
  "manifest_version": 3,
  "name": "Session Switcher Fusion-s",
  "version": "1.0.0",
  "description": "Session management extension with theme customizer and keyboard shortcuts - fusion of fanesz/session-switcher + kuronekony4n/session-switcher2",

  "permissions": ["storage", "tabs", "cookies", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "save-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current session"
    },
    "new-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+N",
        "mac": "Command+Shift+N"
      },
      "description": "Create new session (clear current)"
    },
    "next-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "Command+Shift+Right"
      },
      "description": "Switch to next session"
    },
    "prev-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left",
        "mac": "Command+Shift+Left"
      },
      "description": "Switch to previous session"
    }
  },

  "background": {
    "service_worker": "background/index.js"
  },

  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Session Switcher Fusion-s",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },

  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "session-switcher-fusion-s@punyaadapaa",
      "strict_min_version": "109.0"
    }
  }
}
